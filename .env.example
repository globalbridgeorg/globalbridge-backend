# Backend Environment Variables
# Copy this file to .env and fill in your values

MODE=DEVELOPMENT
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
MY_IP=127.0.0.1

# Database
# DATABASE_URL is optional, defaults to SQLite

# Cloudinary Configuration
# Get these from https://cloudinary.com/console
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# E-mail (opcional em DEVELOPMENT — sem EMAIL_HOST, os e-mails só aparecem
# no console do servidor em vez de serem enviados de verdade)
FRONTEND_URL=http://localhost:5173
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app-de-16-digitos
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GlobalBridge <seu-email@gmail.com>
