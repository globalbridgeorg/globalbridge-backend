# Backend Environment Variables (Django + Supabase Postgres + Supabase Storage)
MODE=DEVELOPMENT
SECRET_KEY=troque-por-uma-chave-segura-em-producao
DEBUG=True
MY_IP=127.0.0.1

# Produção (Render)
# ALLOWED_HOSTS=seu-servico.onrender.com
# CORS_ALLOWED_ORIGINS=https://globalbridge-gamma.vercel.app
# FRONTEND_URL=https://globalbridge-gamma.vercel.app

# Banco de dados (opcional localmente — usa SQLite por padrão)
# Em produção no Render, use a Session Pooler URL (:5432) do Supabase Postgres:
# DATABASE_URL=postgresql://postgres.<project_ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_SCHEMA=django

# Supabase Storage (uploads de avatar, capas, galeria e comprovantes)
# SUPABASE_URL=https://<project_ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Confirmação de e-mail obrigatória no cadastro (ative só se SMTP/Brevo estiver configurado)
REQUIRE_EMAIL_VERIFICATION=False

# E-mail (opcional — sem BREVO_API_KEY nem EMAIL_HOST, imprime no console)
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=GlobalBridge <no-reply@globalbridge.test>
